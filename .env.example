NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to the browser. Required for the sysadmin
# invite-user flow (auth.admin.inviteUserByEmail).
SUPABASE_SERVICE_ROLE_KEY=

# HubSpot private app token (crm notes on contacts). Optional until
# configured — missing token skips sync and records hubspot_sync_note.
HUBSPOT_ACCESS_TOKEN=

# Anthropic API key for churn negative-sentiment signal (Part 3).
# Optional — missing key marks sentiment unavailable and redistributes weight.
ANTHROPIC_API_KEY=

# Bearer token for GET /api/cron/churn-scores (nightly batch).
# Optional in local/dev; set in production before scheduling.
CRON_SECRET=
